        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam roundcorner 10\nskinparam packageStyle rectangle\n\nskinparam class {\n    BackgroundColor White\n    BorderColor #2C3E50\n    ArrowColor #2980B9\n}\n\nclass ATMControllerApp {\n    - atms: List&lt;ATM&gt;\n    - activeIdx: Integer\n    + runDemonstrationScenario(): void\n    + runInteractiveMenu(): void\n}\n\nclass ATM {\n    - id: String\n    - totalCash: Integer\n    - connectionLossProbability: Double\n    - validPin: String\n    - currentState: ATMState\n    - historyLog: List&lt;String&gt;\n    + enterPin(pin: String): OperationResult\n    + withdrawCash(amount: Integer): OperationResult\n    + finishSession(): OperationResult\n    + loadCash(amount: Integer): OperationResult\n    + setState(state: ATMState): void\n    + getState(): ATMState\n    + getStateName(): String\n    + checkBankConnection(): Boolean\n    + verifyPin(pin: String): Boolean\n    + addCash(amount: Integer): void\n    + deductCash(amount: Integer): void\n    + getId(): String\n    + getTotalCash(): Integer\n    + getConnectionLossProbability(): Double\n}\n\nclass OperationResult {\n    + success: Boolean\n    + message: String\n    + previousState: String\n    + currentState: String\n}\n\ninterface ATMState {\n    + getName(): String\n    + enterPin(atm: ATM, pin: String): OperationResult\n    + withdrawCash(atm: ATM, amount: Integer): OperationResult\n    + finishSession(atm: ATM): OperationResult\n    + loadCash(atm: ATM, amount: Integer): OperationResult\n}\n\nclass WaitingState {\n    + getName(): String\n    + enterPin(atm: ATM, pin: String): OperationResult\n    + withdrawCash(atm: ATM, amount: Integer): OperationResult\n    + finishSession(atm: ATM): OperationResult\n    + loadCash(atm: ATM, amount: Integer): OperationResult\n}\n\nclass AuthenticationState {\n    + getName(): String\n    + enterPin(atm: ATM, pin: String): OperationResult\n    + withdrawCash(atm: ATM, amount: Integer): OperationResult\n    + finishSession(atm: ATM): OperationResult\n    + loadCash(atm: ATM, amount: Integer): OperationResult\n}\n\nclass PerformingOperationsState {\n    + getName(): String\n    + enterPin(atm: ATM, pin: String): OperationResult\n    + withdrawCash(atm: ATM, amount: Integer): OperationResult\n    + finishSession(atm: ATM): OperationResult\n    + loadCash(atm: ATM, amount: Integer): OperationResult\n}\n\nclass BlockedState {\n    + getName(): String\n    + enterPin(atm: ATM, pin: String): OperationResult\n    + withdrawCash(atm: ATM, amount: Integer): OperationResult\n    + finishSession(atm: ATM): OperationResult\n    + loadCash(atm: ATM, amount: Integer): OperationResult\n}\n\nATMControllerApp \&quot;1\&quot; *-- \&quot;1..*\&quot; ATM : manages &gt;\nATM \&quot;1\&quot; o-- \&quot;1\&quot; ATMState : currentState &gt;\nATM ..&gt; OperationResult : returns\n\nATMState &lt;|.. WaitingState\nATMState &lt;|.. AuthenticationState\nATMState &lt;|.. PerformingOperationsState\nATMState &lt;|.. BlockedState\n\nnote \&quot;\u0421\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0448\u0430\u0431\u043b\u043e\u043d\u0443 GoF \u00ab\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u00bb (State):\\n\u2022 Context \u2192 ATM\\n\u2022 State \u2192 ATMState\\n\u2022 ConcreteState \u2192 WaitingState, AuthenticationState,\\n  PerformingOperationsState, BlockedState\\n\u2022 Client \u2192 ATMControllerApp\&quot; as N1\n\n@enduml\n&quot;, &quot;config&quot;: null}" id="puml_root">
