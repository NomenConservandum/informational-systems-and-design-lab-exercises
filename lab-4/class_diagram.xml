mount: int): OperationResult\n    + finishSession(atm: ATM&amp;): OperationResult\n    + loadCash(atm: ATM&amp;, amount: int): OperationResult\n}\n\nclass AuthenticationState &lt;&lt;ConcreteState&gt;&gt; {\n    + getName(): string\n    + enterPin(atm: ATM&amp;, pin: string): OperationResult\n    + withdrawCash(atm: ATM&amp;, amount: int): OperationResult\n    + finishSession(atm: ATM&amp;): OperationResult\n    + loadCash(atm: ATM&amp;, amount: int): OperationResult\n}\n\nclass PerformingOperationsState &lt;&lt;ConcreteState&gt;&gt; {\n    + getName(): string\n    + enterPin(atm: ATM&amp;, pin: string): OperationResult\n    + withdrawCash(atm: ATM&amp;, amount: int): OperationResult\n    + finishSession(atm: ATM&amp;): OperationResult\n    + loadCash(atm: ATM&amp;, amount: int): OperationResult\n}\n\nclass BlockedState &lt;&lt;ConcreteState&gt;&gt; {\n    + getName(): string\n    + enterPin(atm: ATM&amp;, pin: string): OperationResult\n    + withdrawCash(atm: ATM&amp;, amount: int): OperationResult\n    + finishSession(atm: ATM&amp;): OperationResult\n    + loadCash(atm: ATM&amp;, amount: int): OperationResult\n}\n\nclass ATMControllerApp &lt;&lt;Client&gt;&gt; {\n    - atms: vector&lt;ATM&gt;\n    - activeIdx: size_t\n    + runDemonstrationScenario(): void\n    + runInteractiveMenu(): void\n}\n\nATMControllerApp \&quot;1\&quot; *-- \&quot;1..*\&quot; ATM : manages &gt;\nATM \&quot;1\&quot; o-- \&quot;1\&quot; ATMState : currentState_ &gt;\nATM ..&gt; OperationResult : returns &gt;\nATMState ..&gt; OperationResult : returns &gt;\n\nATMState &lt;|.. WaitingState\nATMState &lt;|.. AuthenticationState\nATMState &lt;|.. PerformingOperationsState\nATMState &lt;|.. BlockedState\n\nnote right of ATM\n  \u0421\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0448\u0430\u0431\u043b\u043e\u043d\u0443 GoF \u00abState\u00bb:\n  \u2022 Context (\u041a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u0430\u0432\u0442\u043e\u043c\u0430\u0442) -&gt; ATM\n  \u2022 State (\u0418\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f) -&gt; ATMState\n  \u2022 ConcreteStateA -&gt; WaitingState (\u041e\u0436\u0438\u0434\u0430\u043d\u0438\u0435)\n  \u2022 ConcreteStateB -&gt; AuthenticationState (\u0410\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f)\n  \u2022 ConcreteStateC -&gt; PerformingOperationsState (\u0412\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439)\n  \u2022 ConcreteStateD -&gt; BlockedState (\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d: \u0434\u0435\u043d\u0435\u0433 \u043d\u0435\u0442)\nend note\n\n@enduml\n&quot;, &quot;config&quot;: null}" id="puml_root">
