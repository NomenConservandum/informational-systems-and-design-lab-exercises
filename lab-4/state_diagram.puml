@startuml
skinparam monochrome false
skinparam roundcorner 16
skinparam shadowing false

skinparam state {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor #2C3E50
    StartColor #27AE60
    EndColor #C0392B
    FontName Helvetica
}

[*] --> WaitingState : [balance > 0]
[*] --> BlockedState : [balance <= 0]

state "WaitingState (Ожидание)" as WaitingState #dae8fc {
    WaitingState : entry / ожидание вызова (линия свободна)
    WaitingState : makeCall(target) [вызов не прошёл] / остаётся в ожидании
    WaitingState : topUpBalance(amount) [amount > 0] / balance += amount
    WaitingState : answerCall() / отказ
    WaitingState : endCall() / отказ
}

state "CallingState (Звонок)" as CallingState #ffe6cc {
    CallingState : entry / идут гудки вызова абонента
    CallingState : topUpBalance(amount) [amount > 0] / balance += amount
    CallingState : makeCall(target) / отказ (линия занята)
}

state "TalkingState (Разговор)" as TalkingState #d5e8d4 {
    TalkingState : entry / голосовое соединение установлено
    TalkingState : topUpBalance(amount) [amount > 0] / balance += amount
    TalkingState : makeCall(target) / отказ (идёт разговор)
    TalkingState : answerCall() / отказ (уже на линии)
}

state "BlockedState (Заблокирован: нет средств)" as BlockedState #f8cecc {
    BlockedState : entry / звонки заблокированы (balance <= 0)
    BlockedState : topUpBalance(amount) [balance <= 0] / остаётся заблокирован
    BlockedState : makeCall(target) / отказ
    BlockedState : answerCall() / отказ
    BlockedState : endCall() / отказ
}

WaitingState --> CallingState : makeCall(target) [balance > 0 и вызов прошёл]
CallingState --> WaitingState : endCall() [отмена вызова]
CallingState --> TalkingState : answerCall()
TalkingState --> WaitingState : endCall() [balance - callCost > 0]
TalkingState --> BlockedState : endCall() [balance - callCost <= 0]
BlockedState --> WaitingState : topUpBalance(amount) [balance > 0]

@enduml
