@startuml
skinparam monochrome false
skinparam roundcorner 16
skinparam shadowing false

skinparam state {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor #2C3E50
    StartColor #27AE60
    EndColor #C0392B
    FontName Helvetica
}

[*] --> WaitingState : [balance >= 0]
[*] --> BlockedState : [balance < 0]

state "WaitingState (Ожидание)" as WaitingState #dae8fc {
    WaitingState : entry / ожидание вызова (balance >= 0)
    WaitingState : topUpBalance(amount) [amount > 0] / balance += amount
    WaitingState : endCall() / отказ
}

state "CallingState (Звонок)" as CallingState #ffe6cc {
    CallingState : entry / идут гудки исходящего вызова
    CallingState : topUpBalance(amount) [amount > 0] / balance += amount
    CallingState : makeCall(target) / отказ (линия занята)
}

state "TalkingState (Разговор)" as TalkingState #d5e8d4 {
    TalkingState : entry / голосовое соединение установлено
    TalkingState : topUpBalance(amount) [amount > 0] / balance += amount
    TalkingState : makeCall(target) / отказ (идёт разговор)
    TalkingState : answerCall() / отказ (уже на линии)
}

state "BlockedState (Заблокирован: баланс отрицательный)" as BlockedState #f8cecc {
    BlockedState : entry / исходящие заблокированы (balance < 0)
    BlockedState : topUpBalance(amount) [balance < 0] / заблокирован
    BlockedState : makeCall(target) / отказ (баланс < 0)
    BlockedState : endCall() / отказ
}

WaitingState --> CallingState : makeCall(target) [balance >= 0]
CallingState --> WaitingState : endCall() [отмена вызова]
CallingState --> TalkingState : answerCall() [ответ собеседника]
WaitingState --> TalkingState : answerCall() [входящий, 0 руб.]
BlockedState --> TalkingState : answerCall() [входящий, 0 руб.]
TalkingState --> WaitingState : endCall() [исх.: -callCost, вх.: 0; balance >= 0]
TalkingState --> BlockedState : endCall() [исх.: -callCost, вх.: 0; balance < 0]
BlockedState --> WaitingState : topUpBalance(amount) [balance >= 0]

@enduml
