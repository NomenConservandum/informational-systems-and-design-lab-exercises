@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 10
skinparam shadowing false

skinparam class {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor #2C3E50
    FontName Helvetica
}

class PhoneControllerApp {
    - phones: List<Phone>
    - activeIdx: Integer
    + runDemonstrationScenario(): void
    + runInteractiveMenu(): void
}

class Phone {
    - phoneNumber: String
    - balance: Integer
    - callProbability: Double
    - callCost: Integer
    - activePeerNumber: String
    - currentState: PhoneState
    - historyLog: List<String>
    + makeCall(targetNumber: String): OperationResult
    + answerCall(): OperationResult
    + endCall(): OperationResult
    + topUpBalance(amount: Integer): OperationResult
    + setState(state: PhoneState): void
    + getState(): PhoneState
    + getStateName(): String
    + checkCallProbability(): Boolean
    + addBalance(amount: Integer): void
    + deductCallCost(): void
    + getPhoneNumber(): String
    + getBalance(): Integer
    + getCallProbability(): Double
}

interface PhoneState <<interface>> {
    + getName(): String
    + makeCall(phone: Phone, targetNumber: String): OperationResult
    + answerCall(phone: Phone): OperationResult
    + endCall(phone: Phone): OperationResult
    + topUpBalance(phone: Phone, amount: Integer): OperationResult
}

class WaitingState {
    + getName(): String
    + makeCall(phone: Phone, targetNumber: String): OperationResult
    + answerCall(phone: Phone): OperationResult
    + endCall(phone: Phone): OperationResult
    + topUpBalance(phone: Phone, amount: Integer): OperationResult
}

class CallingState {
    + getName(): String
    + makeCall(phone: Phone, targetNumber: String): OperationResult
    + answerCall(phone: Phone): OperationResult
    + endCall(phone: Phone): OperationResult
    + topUpBalance(phone: Phone, amount: Integer): OperationResult
}

class TalkingState {
    + getName(): String
    + makeCall(phone: Phone, targetNumber: String): OperationResult
    + answerCall(phone: Phone): OperationResult
    + endCall(phone: Phone): OperationResult
    + topUpBalance(phone: Phone, amount: Integer): OperationResult
}

class BlockedState {
    + getName(): String
    + makeCall(phone: Phone, targetNumber: String): OperationResult
    + answerCall(phone: Phone): OperationResult
    + endCall(phone: Phone): OperationResult
    + topUpBalance(phone: Phone, amount: Integer): OperationResult
}

class OperationResult {
    + success: Boolean
    + message: String
    + previousState: String
    + currentState: String
}

PhoneControllerApp "1" *-- "1..*" Phone : manages
Phone "1" o-- "1" PhoneState : currentState
Phone ..> OperationResult : returns

PhoneState <|.. WaitingState
PhoneState <|.. CallingState
PhoneState <|.. TalkingState
PhoneState <|.. BlockedState

note top of PhoneState
  Соответствие шаблону проектирования GoF «Состояние» (State):
  • Context (конечный автомат) → Phone
  • State (интерфейс состояния) → PhoneState
  • ConcreteState → WaitingState (Ожидание)
  • ConcreteState → CallingState (Звонок)
  • ConcreteState → TalkingState (Разговор)
  • ConcreteState → BlockedState (Заблокирован: нет средств)
  • Client → PhoneControllerApp
end note

@enduml
