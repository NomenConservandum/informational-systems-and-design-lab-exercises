        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\nskinparam monochrome false\nskinparam roundcorner 10\nskinparam shadowing false\n\nskinparam state {\n    BackgroundColor White\n    BorderColor #2C3E50\n    ArrowColor #2980B9\n    StartColor #27AE60\n    EndColor #C0392B\n}\n\n[*] --&gt; WaitingState : [totalCash &gt; 0]\n[*] --&gt; BlockedState : [totalCash == 0]\n\nstate WaitingState as \&quot;WaitingState\\n(\u041e\u0436\u0438\u0434\u0430\u043d\u0438\u0435)\&quot; {\n    WaitingState : entry / \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u0430\n    WaitingState : loadCash(amount) [amount &gt; 0] / totalCash += amount\n    WaitingState : withdrawCash(amount) / \u043e\u0442\u043a\u0430\u0437\n    WaitingState : finishSession() / \u043e\u0442\u043a\u0430\u0437\n}\n\nstate AuthenticationState as \&quot;AuthenticationState\\n(\u0410\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f)\&quot; {\n    AuthenticationState : entry / \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0441\u0432\u044f\u0437\u0438 \u0441 \u0431\u0430\u043d\u043a\u043e\u043c \u0438 PIN-\u043a\u043e\u0434\u0430\n    AuthenticationState : enterPin(pin) [\u043d\u0435\u0442 \u0441\u0432\u044f\u0437\u0438 \u0438\u043b\u0438 \u043d\u0435\u0432\u0435\u0440\u043d\u044b\u0439 PIN] / \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0439 \u0432\u0432\u043e\u0434\n    AuthenticationState : withdrawCash(amount) / \u043e\u0442\u043a\u0430\u0437\n    AuthenticationState : loadCash(amount) / \u043e\u0442\u043a\u0430\u0437\n}\n\nstate PerformingOperationsState as \&quot;PerformingOperationsState\\n(\u0412\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439)\&quot; {\n    PerformingOperationsState : entry / \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u043c \u043e\u0442\u043a\u0440\u044b\u0442\n    PerformingOperationsState : withdrawCash(amount) [\u0441\u0432\u044f\u0437\u044c \u0435\u0441\u0442\u044c \u0438 amount &lt; totalCash] / \u0432\u044b\u0434\u0430\u0447\u0430\n    PerformingOperationsState : withdrawCash(amount) [\u043d\u0435\u0442 \u0441\u0432\u044f\u0437\u0438 \u0438\u043b\u0438 amount &gt; totalCash] / \u043e\u0442\u043a\u0430\u0437\n    PerformingOperationsState : enterPin(pin) / \u043e\u0442\u043a\u0430\u0437\n    PerformingOperationsState : loadCash(amount) / \u043e\u0442\u043a\u0430\u0437\n}\n\nstate BlockedState as \&quot;BlockedState\\n(\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d: \u0434\u0435\u043d\u0435\u0433 \u043d\u0435\u0442)\&quot; {\n    BlockedState : entry / \u0432\u044b\u0434\u0430\u0447\u0430 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u0430 (totalCash == 0)\n    BlockedState : enterPin(pin) / \u043e\u0442\u043a\u0430\u0437\n    BlockedState : withdrawCash(amount) / \u043e\u0442\u043a\u0430\u0437\n    BlockedState : finishSession() / \u043e\u0442\u043a\u0430\u0437\n}\n\nWaitingState --&gt; AuthenticationState : enterPin(pin) [\u043d\u0435\u0442 \u0441\u0432\u044f\u0437\u0438 \u0438\u043b\u0438 \u043d\u0435\u0432\u0435\u0440\u043d\u044b\u0439 PIN]\nAuthenticationState --&gt; WaitingState : finishSession()\nWaitingState --&gt; PerformingOperationsState : enterPin(pin) [\u0441\u0432\u044f\u0437\u044c \u0435\u0441\u0442\u044c \u0438 PIN \u0432\u0435\u0440\u043d\u044b\u0439]\nAuthenticationState --&gt; PerformingOperationsState : enterPin(pin) [\u0441\u0432\u044f\u0437\u044c \u0435\u0441\u0442\u044c \u0438 PIN \u0432\u0435\u0440\u043d\u044b\u0439]\nPerformingOperationsState --&gt; WaitingState : finishSession()\nPerformingOperationsState --&gt; BlockedState : withdrawCash(amount) [amount == totalCash]\nBlockedState --&gt; WaitingState : loadCash(amount) [amount &gt; 0]\n\n@enduml\n&quot;, &quot;config&quot;: null}" id="puml_