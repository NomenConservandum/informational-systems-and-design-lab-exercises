3e\u0434 \u043d\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d\n    AuthenticationState : loadCash(amount) / \u043e\u0442\u043a\u0430\u0437: \u0441\u0435\u0430\u043d\u0441 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 \u0430\u043a\u0442\u0438\u0432\u0435\u043d\n}\n\nstate PerformingOperationsState as \&quot;PerformingOperationsState\\n(\u0412\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439)\&quot; {\n    PerformingOperationsState : entry / \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f\u043c \u043e\u0442\u043a\u0440\u044b\u0442\n    PerformingOperationsState : withdrawCash(amount) [\u0441\u0432\u044f\u0437\u044c \u041e\u041a &amp;&amp; amount &lt; totalCash] / totalCash -= amount\n    PerformingOperationsState : withdrawCash(amount) [\u043d\u0435\u0442 \u0441\u0432\u044f\u0437\u0438 \u0418\u041b\u0418 amount &gt; totalCash] / \u043e\u0442\u043a\u0430\u0437 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438\n    PerformingOperationsState : enterPin(pin) / \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435: PIN \u0443\u0436\u0435 \u0432\u0432\u0435\u0434\u0451\u043d\n    PerformingOperationsState : loadCash(amount) / \u043e\u0442\u043a\u0430\u0437: \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0441\u0435\u0430\u043d\u0441\n}\n\nstate BlockedState as \&quot;BlockedState\\n(\u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d: \u0434\u0435\u043d\u0435\u0433 \u043d\u0435\u0442)\&quot; {\n    BlockedState : entry / \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u0432\u044b\u0434\u0430\u0447\u0438 (totalCash == 0)\n    BlockedState : enterPin(pin) / \u043e\u0442\u043a\u0430\u0437: \u043d\u0435\u0442 \u043d\u0430\u043b\u0438\u0447\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\n    BlockedState : withdrawCash(amount) / \u043e\u0442\u043a\u0430\u0437: \u043a\u0430\u0441\u0441\u0435\u0442\u044b \u043f\u0443\u0441\u0442\u044b\n    BlockedState : finishSession() / \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u0435 \u0438\u043d\u043a\u0430\u0441\u0441\u0430\u0446\u0438\u0438\n}\n\nWaitingState --&gt; AuthenticationState : enterPin(pin)\\n[\u043d\u0435\u0442 \u0441\u0432\u044f\u0437\u0438 \u0441 \u0431\u0430\u043d\u043a\u043e\u043c \u0418\u041b\u0418 \u043d\u0435\u0432\u0435\u0440\u043d\u044b\u0439 PIN]\nWaitingState --&gt; PerformingOperationsState : enterPin(pin)\\n[\u0441\u0432\u044f\u0437\u044c \u0441 \u0431\u0430\u043d\u043a\u043e\u043c \u041e\u041a \u0418 \u0432\u0435\u0440\u043d\u044b\u0439 PIN]\n\nAuthenticationState --&gt; PerformingOperationsState : enterPin(pin)\\n[\u0441\u0432\u044f\u0437\u044c \u0441 \u0431\u0430\u043d\u043a\u043e\u043c \u041e\u041a \u0418 \u0432\u0435\u0440\u043d\u044b\u0439 PIN]\nAuthenticationState --&gt; WaitingState : finishSession()\\n/ \u043e\u0442\u043c\u0435\u043d\u0430 \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438\n\nPerformingOperationsState --&gt; WaitingState : finishSession()\\n/ \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f\nPerformingOperationsState --&gt; BlockedState : withdrawCash(amount)\\n[\u0441\u0432\u044f\u0437\u044c \u041e\u041a &amp;&amp; amount == totalCash]\\n/ \u0432\u044b\u0434\u0430\u0447\u0430 \u043e\u0441\u0442\u0430\u0442\u043a\u0430 (totalCash = 0)\n\nBlockedState --&gt; WaitingState : loadCash(amount) [amount &gt; 0]\\n/ \u0438\u043d\u043a\u0430\u0441\u0441\u0430\u0446\u0438\u044f (totalCash += amount)\n\n@enduml\n&quot;, &quot;config&quot;: null}" id="puml_root">
