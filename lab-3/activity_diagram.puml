@startuml
skinparam monochrome false
skinparam roundcorner 10
skinparam shadowing false
skinparam packageStyle rectangle

skinparam activity {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor #2980B9
    StartColor #27AE60
    EndColor #C0392B
    BarColor #2C3E50
}

skinparam partition {
    BackgroundColor #F8F9FA
    BorderColor #BDC3C7
}

|Преподаватель|
start
:Создать черновик курса (специальность, курс, семестр,\nчисло студентов, даты начала и окончания);
:Задать аудиторные часы (лекции, практики, лабы)\nи формы контроля (зачёт, экзамен, кол-во КР);

repeat
    :Сформировать темы курса и распределить часы;
    :Отметить необязательные темы (вынос на СРС);

    |ИС «Кафедры»|
    :Проверить лимит СРС по видам занятий\n(часы СРС <= 15% от общих часов дисциплины);

    if (Часы СРС превышают 15%?) then (да)
        |Преподаватель|
        :Получить предупреждение о превышении нормы СРС;
        :Скорректировать темы и часы;
    else (нет)
        break
    endif
repeat while (требуется корректировка)

|ИС «Кафедры»|
:Рассчитать часы консультаций:\n• текущие = 0.05 * лекционные часы\n• экзаменационные = 2 ч (если есть экзамен);
:Рассчитать часы контроля:\n• экзамен = 0.5 ч * кол-во студентов (при экзамене)\n• зачёт = 0.25 ч * кол-во студентов (при зачёте)\n• проверка КР = 0.15 ч * кол-во студентов * кол-во КР;
:Суммировать все часы и округлить вверх до целого;
:Рассчитать количество недель W между датами семестра;
:Рассчитать количество пар в неделю для каждого вида:\nПары = Часы / (2 * W);

|Преподаватель|
:Отправить программу и расчет нагрузки\nна согласование заведующему кафедрой;

|Заведующий кафедрой|
:Провести экспертизу рабочей программы курса;

if (Программа соответствует требованиям?) then (нет)
    :Вернуть на доработку с замечаниями;
    |Преподаватель|
    :Скорректировать параметры курса;
    detach
else (да)
    |Заведующий кафедрой|
    :Утвердить на заседании кафедры и передать в деканат;
endif

|Деканат|
:Проверить общее количество преподавателей всех кафедр:\nTotalTeachers <= studentCount / 10;

if (Квота ППС соблюдена?) then (нет)
    :Заблокировать утверждение и затребовать\nоптимизацию нагрузки факультета;
    stop
else (да)
    :Утвердить рабочую программу курса;
endif

|ИС «Кафедры»|
:Перевести курс в статус ASSIGNED;\nВключить курс в официальное расписание семестра;

stop
@enduml
