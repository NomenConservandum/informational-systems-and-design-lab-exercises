@startuml
skinparam monochrome false
skinparam roundcorner 10
skinparam shadowing false
skinparam packageStyle rectangle

skinparam activity {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor #2980B9
    StartColor #27AE60
    EndColor #C0392B
    BarColor #2C3E50
}

skinparam partition {
    BackgroundColor #F8F9FA
    BorderColor #BDC3C7
}

|Деканат|
start
:Актуализировать контингент студентов факультета;

|ИС «Кафедры»|
:Проверить норматив ППС факультета:\nВсего преподавателей кафедр <= studentCount / 10;

if (Норматив 10:1 соблюден?) then (нет)
    |Деканат|
    :Заблокировать добавление новых сотрудников;\nПотребовать корректировки контингента или штата;
    stop
else (да)

|Заведующий кафедрой|
:Вести кадровый учёт преподавателей кафедры\n(добавление, обновление данных о преподавателях);
:Просмотреть курсы учебного плана кафедры\n(статус Unassigned);
:Выбрать курс и назначить ответственного\nпреподавателя из штата кафедры;

|Преподаватель|
:Принять закрепленный курс к исполнению\n(статус курса: Assigned);
:Указать форму отчётности (ReportingForm:\nEXAM либо PASS_TEST) и количество КР;
:Указать календарные даты семестра (startDate, endDate);

repeat
    :Добавить темы курса и распределить\nчасы по видам (лекции, практики, лабы);
    :Отметить темы для выноса на\nсамостоятельную работу (СРС);

    |ИС «Кафедры»|
    :Проверить лимит часов СРС по каждому виду:\nчасы СРС <= 15% от общего объема данного вида;

    if (Часы СРС превышают 15%?) then (да)
        |Преподаватель|
        :Получить предупреждение о нарушении порога СРС;\nСкорректировать темы и часы;
    else (нет)
        break
    endif
repeat while (требуется корректировка)

|ИС «Кафедры»|
:Рассчитать часы текущих консультаций:\n0.05 * lectureHours;

if (ReportingForm == EXAM?) then (да)
    :Добавить 2 ч предэкзаменационной консультации;\nРассчитать приём экзамена: 0.5 ч * studentCount;
else (нет)
    :Рассчитать приём зачёта: 0.25 ч * studentCount;
endif

:Рассчитать часы проверки КР:\n0.15 ч * studentCount * controlWorkCount;
:Суммировать и округлить вверх:\nTotalHours = ceil(сумма всех часов);
:Рассчитать учебных недель W = floor((endDate - startDate) / 7);\nРассчитать сетку пар в неделю: Пары = Часы / (2 * W);
:Перевести курс в статус Configured;\nВключить курс в официальное расписание занятий;

endif

stop
@enduml

