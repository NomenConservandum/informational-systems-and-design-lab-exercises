        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam roundcorner 10\nskinparam actorStyle awesome\nskinparam monochrome false\nskinparam handwritten false\n\nskinparam usecase {\n    BackgroundColor White\n    BorderColor #2C3E50\n    ArrowColor #2980B9\n}\n\nskinparam actor {\n    BackgroundColor White\n    BorderColor #2C3E50\n}\n\nactor \&quot;\u0414\u0435\u043a\u0430\u043d / \u0414\u0435\u043a\u0430\u043d\u0430\u0442\&quot; as Dean\nactor \&quot;\u0417\u0430\u0432\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043a\u0430\u0444\u0435\u0434\u0440\u043e\u0439\&quot; as Head\nactor \&quot;\u041f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c\&quot; as Teacher\nactor \&quot;\u0414\u0438\u0441\u043f\u0435\u0442\u0447\u0435\u0440 \u0443\u0447\u0435\u0431\u043d\u043e\u0433\u043e \u043e\u0442\u0434\u0435\u043b\u0430\&quot; as Registrar\nactor \&quot;\u0421\u0442\u0443\u0434\u0435\u043d\u0442 / \u0413\u043e\u0441\u0442\u044c\&quot; as Student\n\nrectangle \&quot;\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u00ab\u041a\u0430\u0444\u0435\u0434\u0440\u044b\u00bb\&quot; {\n\n    package \&quot;\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430 \u0438 \u0434\u0435\u043a\u0430\u043d\u0430\u0442\u0430\&quot; {\n        usecase \&quot;UC1: \u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043e\u0439 \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0430\&quot; as UC1\n        usecase \&quot;UC1.1: \u041f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u043a\u0432\u043e\u0442\u0443 \u041f\u041f\u0421 \u043a \u0441\u0442\u0443\u0434\u0435\u043d\u0442\u0430\u043c (10:1)\&quot; as UC1_1\n        usecase \&quot;UC6: \u0423\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u0440\u0430\u0431\u043e\u0447\u0443\u044e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u043a\u0443\u0440\u0441\u0430\&quot; as UC6\n        usecase \&quot;UC9: \u0424\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0434\u043d\u044b\u0439 \u043e\u0442\u0447\u0451\u0442 \u043f\u043e \u0444\u0430\u043a\u0443\u043b\u044c\u0442\u0435\u0442\u0443\&quot; as UC9\n\n        UC1 ..&gt; UC1_1 : &lt;&lt;include&gt;&gt;\n    }\n\n    package \&quot;\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043a\u0430\u0444\u0435\u0434\u0440\u044b\&quot; {\n        usecase \&quot;UC2: \u0412\u0435\u0441\u0442\u0438 \u0443\u0447\u0451\u0442 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u043a\u0430\u0444\u0435\u0434\u0440\u044b\&quot; as UC2\n        usecase \&quot;UC3: \u0420\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u043a\u0443\u0440\u0441\u044b \u043c\u0435\u0436\u0434\u0443 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044f\u043c\u0438\&quot; as UC3\n        usecase \&quot;UC3.1: \u041a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0443\u043c\u043c\u0430\u0440\u043d\u0443\u044e \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0443 \u043a\u0430\u0444\u0435\u0434\u0440\u044b\&quot; as UC3_1\n        usecase \&quot;UC6.1: \u0421\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u0442\u044c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u043a\u0443\u0440\u0441\u0430 \u043d\u0430 \u043a\u0430\u0444\u0435\u0434\u0440\u0435\&quot; as UC6_1\n\n        UC3 ..&gt; UC3_1 : &lt;&lt;include&gt;&gt;\n    }\n\n    package \&quot;\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0443\u0447\u0435\u0431\u043d\u043e\u0433\u043e \u043a\u0443\u0440\u0441\u0430 \u0438 \u0442\u0435\u043c\&quot; {\n        usecase \&quot;UC4: \u0421\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0440\u0430\u0431\u043e\u0447\u0443\u044e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u043a\u0443\u0440\u0441\u0430\&quot; as UC4\n        usecase \&quot;UC4.1: \u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0442\u044c \u0447\u0430\u0441\u044b \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u0439 (0.05*\u043b\u0435\u043a\u0446\u0438\u0438 + 2\u0447)\&quot; as UC4_1\n        usecase \&quot;UC4.2: \u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0442\u044c \u0447\u0430\u0441\u044b \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430 / \u0437\u0430\u0447\u0451\u0442\u0430\&quot; as UC4_2\n        usecase \&quot;UC4.3: \u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0442\u044c \u0447\u0430\u0441\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u041a\u0420\&quot; as UC4_3\n        usecase \&quot;UC4.4: \u041e\u043a\u0440\u0443\u0433\u043b\u0438\u0442\u044c \u043e\u0431\u0449\u0443\u044e \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0443 \u0432\u0432\u0435\u0440\u0445\&quot; as UC4_4\n\n        usecase \&quot;UC5: \u0421\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0442\u0435\u043c\u044b \u0438 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0447\u0430\u0441\u044b\&quot; as UC5\n        usecase \&quot;UC5.1: \u041f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u043b\u0438\u043c\u0438\u0442 \u0421\u0420\u0421 (&lt;= 15% \u043f\u043e \u0432\u0438\u0434\u0430\u043c)\&quot; as UC5_1\n\n        UC4 ..&gt; UC4_1 : &lt;&lt;include&gt;&gt;\n        UC4 ..&gt; UC4_2 : &lt;&lt;include&gt;&gt;\n        UC4 ..&gt; UC4_3 : &lt;&lt;include&gt;&gt;\n        UC4 ..&gt; UC4_4 : &lt;&lt;include&gt;&gt;\n\n        UC5 ..&gt; UC5_1 : &lt;&lt;include&gt;&gt;\n    }\n\n    package \&quot;\u041a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u043d\u043e\u0435 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\&quot; {\n        usecase \&quot;UC7: \u0420\u0430\u0441\u0441\u0447\u0438\u0442