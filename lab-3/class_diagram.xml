        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam roundcorner 10\nskinparam packageStyle rectangle\n\nskinparam class {\n    BackgroundColor White\n    BorderColor #2C3E50\n    ArrowColor #2980B9\n}\n\nenum AcademicDegree {\n    NONE\n    CANDIDATE_OF_SCIENCES\n    DOCTOR_OF_SCIENCES\n    PHD\n}\n\nenum AcademicTitle {\n    NONE\n    DOCENT\n    PROFESSOR\n}\n\nenum Position {\n    ASSISTANT\n    SENIOR_LECTURER\n    DOCENT\n    PROFESSOR\n    DEPARTMENT_HEAD\n}\n\nenum Gender {\n    MALE\n    FEMALE\n}\n\nenum CourseStatus {\n    DRAFT\n    DEPARTMENT_REVIEW\n    DEAN_APPROVED\n    ASSIGNED\n    IN_PROGRESS\n    SESSION_EVALUATION\n    COMPLETED\n    ARCHIVED\n}\n\nclass Faculty {\n    - name: String\n    - deanFullName: String\n    - phone: String\n    - deanOfficeRoom: String\n    - studentCount: Integer\n    - foundationDate: Date\n    + addDepartment(dept: Department): void\n    + removeDepartment(dept: Department): void\n    + getDepartments(): List&lt;Department&gt;\n    + calculateTotalTeachers(): Integer\n    + validateStaffToStudentRatio(): Boolean\n}\n\nclass Department {\n    - name: String\n    - headFullName: String\n    - phone: String\n    - roomNumber: String\n    - isGraduating: Boolean\n    - foundationDate: Date\n    + addTeacher(teacher: Teacher): void\n    + removeTeacher(teacher: Teacher): void\n    + getTeachers(): List&lt;Teacher&gt;\n    + addCourse(course: Course): void\n    + getCourses(): List&lt;Course&gt;\n    + getTeacherCount(): Integer\n    + calculateTotalLoadHours(): Integer\n}\n\nclass Teacher {\n    - lastName: String\n    - firstName: String\n    - middleName: String\n    - academicDegree: AcademicDegree\n    - academicTitle: AcademicTitle\n    - position: Position\n    - gender: Gender\n    - birthDate: Date\n    + getFullName(): String\n    + assignCourse(course: Course): void\n    + removeCourse(course: Course): void\n    + getCourses(): List&lt;Course&gt;\n    + getCourseCount(): Integer\n    + calculateTotalLoad(): Integer\n}\n\nclass Course {\n    - title: String\n    - specialty: String\n    - studyYear: Integer\n    - semester: Integer\n    - studentCount: Integer\n    - lectureHours: Integer\n    - practiceHours: Integer\n    - labHours: Integer\n    - hasCredit: Boolean\n    - hasExam: Boolean\n    - testCount: Integer\n    - startDate: Date\n    - endDate: Date\n    - status: CourseStatus\n    + addTopic(topic: Topic): void\n    + removeTopic(topic: Topic): void\n    + getTopics(): List&lt;Topic&gt;\n    + calculateWeeks(): Integer\n    + calculateConsultationHours(): Double\n    + calculateExamConsultationHours(): Double\n    + calculateExamEvaluationHours(): Double\n    + calculateCreditEvaluationHours(): Double\n    + calculateTestGradingHours(): Double\n    + calculateTotalHours(): Integer\n    + calculateLecturePairsPerWeek(): Double\n    + calculatePracticePairsPerWeek(): Double\n    + calculateLabPairsPerWeek(): Double\n    + validateSelfStudyLimits(): Boolean\n    + updateStatus(newStatus: CourseStatus): void\n}\n\nclass Topic {\n    - title: String\n    - lectureHours: Integer\n    - practiceHours: Integer\n    - labHours: Integer\n    - isMandatory: Boolean\n    + getTotalHours(): Integer\n    + canBeSelfStudy(): Boolean\n    + setMandatory(mandatory: Boolean): void\n}\n\nFaculty \&quot;1\&quot; *-- \&quot;1..*\&quot; Department : contains &gt;\nDepartment \&quot;1\&quot; *-- \&quot;1..*\&quot; Teacher : employs &gt;\nDepartment \&quot;1\&quot; o-- \&quot;*\&quot; Course : oversees &gt;\nTeacher \&quot;1\&quot; o-- \&quot;*\&quot; Course : lectures &gt;\nCourse \&quot;1\&quot; *-- \&quot;1..*\&quot; Topic : consists of &gt;\n\nTeacher ..&gt; AcademicDegree : uses\nTeacher ..&gt; AcademicTitle : uses\nTeacher ..&gt; Position : uses\nTeacher ..&gt; Gender : uses\nCourse ..&gt; CourseStatus : tracks\n\nnote right of Faculty\n  &lt;b&gt;\u0411\u0438\u0437\u043d\u0435\u0441-\u043f\u0440\u0430\u0432\u0438\u043b\u043e 1:&lt;/b&gt;\n  calculateTotalTeachers() &lt;= studentCount / 10\nend note\n\nnote bottom of Course\n  &lt;b&gt;\u0424\u043e\u0440\u043c\u0443\u043b\u0430 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438:&lt;/b&gt;\n  TotalHours = ceil(\n    Lectures + Practices + Labs\n    + 0.05 * Lectures\n    + (hasExam ? 2.0 : 0)\n    + (hasExam ? 0.5 * studentCount : 0)\n    + (hasCredit ? 0.25 * studentCount : 0)\n    + (0.15 * studentCount * testCount)\n  )\n  &lt;b&gt;\u041f\u0430\u0440 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e:&lt;/b&gt;\n  Pairs = Hours / (2 * Weeks)\nend note\n\nnote right of Topic\n  &lt;b&gt;\u0411\u0438\u0437\u043d\u0435\u0441-\u043f\u0440\u0430\u0432\u0438\u043b\u043e 2:&lt;/b&gt;\n  \u0414\u043b\u044f \u0442\u0435\u043c \u043d\u0430 \u0421\u0420\u0421 (isMandatory = false):\n  hoursSelfStudy &lt;= 0.15 * courseTotalHours\nend note\n\n@enduml\n&quot;, &quot;config&quot;: null}" id="puml_root">
