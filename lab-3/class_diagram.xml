        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam roundcorner 10\nskinparam packageStyle rectangle\n\nskinparam class {\n    BackgroundColor White\n    BorderColor #2C3E50\n    ArrowColor #2980B9\n}\n\nenum AcademicDegree {\n    NONE\n    CANDIDATE_OF_SCIENCES\n    DOCTOR_OF_SCIENCES\n    PHD\n}\n\nenum AcademicTitle {\n    NONE\n    DOCENT\n    PROFESSOR\n}\n\nenum Position {\n    ASSISTANT\n    SENIOR_LECTURER\n    DOCENT\n    PROFESSOR\n    DEPARTMENT_HEAD\n}\n\nenum Gender {\n    MALE\n    FEMALE\n}\n\nenum ReportingForm {\n    EXAM        ' \u042d\u043a\u0437\u0430\u043c\u0435\u043d: 0.5 \u0447 * \u0441\u0442\u0443\u0434 + 2 \u0447 \u043f\u0440\u0435\u0434\u044d\u043a\u0437. \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f\n    PASS_TEST   ' \u0417\u0430\u0447\u0451\u0442: 0.25 \u0447 * \u0441\u0442\u0443\u0434\n}\n\nclass Faculty {\n    - name: String\n    - deanFullName: String\n    - phone: String\n    - deanOfficeRoom: String\n    - studentCount: Integer\n    - foundationDate: Date\n    + addDepartment(dept: Department): void\n    + removeDepartment(dept: Department): void\n    + getDepartments(): List&lt;Department&gt;\n    + calculateTotalTeachers(): Integer\n    + validateStaffToStudentRatio(): Boolean\n}\n\nclass Department {\n    - name: String\n    - headFullName: String\n    - phone: String\n    - roomNumber: String\n    - teacherCount: Integer\n    - isGraduating: Boolean\n    - foundationDate: Date\n    + addTeacher(teacher: Teacher): void\n    + removeTeacher(teacher: Teacher): void\n    + getTeachers(): List&lt;Teacher&gt;\n    + addCourse(course: Course): void\n    + getCourses(): List&lt;Course&gt;\n    + getTeacherCount(): Integer\n    + assignCourseToTeacher(course: Course, teacher: Teacher): void\n    + calculateTotalLoadHours(): Integer\n}\n\nclass Teacher {\n    - lastName: String\n    - firstName: String\n    - middleName: String\n    - academicDegree: AcademicDegree\n    - academicTitle: AcademicTitle\n    - position: Position\n    - gender: Gender\n    - birthDate: Date\n    - courseCount: Integer\n    + getFullName(): String\n    + assignCourse(course: Course): void\n    + removeCourse(course: Course): void\n    + getCourses(): List&lt;Course&gt;\n    + getCourseCount(): Integer\n    + calculateTotalLoad(): Integer\n}\n\nclass Course {\n    - title: String\n    - specialty: String\n    - studyYear: Integer\n    - semester: Integer\n    - studentCount: Integer\n    + getAuditoryHours(): AuditoryHours\n    + getAssessmentPlan(): AssessmentPlan\n    + getSchedule(): CourseSchedule\n    + addTopic(topic: Topic): void\n    + removeTopic(topic: Topic): void\n    + getTopics(): List&lt;Topic&gt;\n    + calculateTotalHours(): Integer\n    + validateSelfStudyLimits(): Boolean\n}\n\nclass AuditoryHours {\n    - lectureHours: Integer\n    - practiceHours: Integer\n    - labHours: Integer\n    + getLectureHours(): Integer\n    + getPracticeHours(): Integer\n    + getLabHours(): Integer\n    + getTotalAuditoryHours(): Integer\n}\n\nclass AssessmentPlan {\n    - reportingForm: ReportingForm\n    - controlWorkCount: Integer\n    + getReportingForm(): ReportingForm\n    + getControlWorkCount(): Integer\n    + calculateEvaluationHours(studentCount: Integer): Double\n    + calculateExamConsultationHours(): Double\n    + calculateTestGradingHours(studentCount: Integer): Double\n}\n\nclass CourseSchedule {\n    - startDate: Date\n    - endDate: Date\n    + getStartDate(): Date\n    + getEndDate(): Date\n    + calculateWeeks(): Integer\n    + calculateWeeklyPairs(hours: Integer): Double\n}\n\nclass AcademicLoad &lt;&lt;utility&gt;&gt; {\n    + {static} calculateConsultationHours(lectureHours: Integer): Double\n    + {static} calculateTotalHours(auditory: AuditoryHours, assessment: AssessmentPlan, studentCount: Integer): Integer\n}\n\nclass Topic {\n    - title: String\n    - lectureHours: Integer\n    - practiceHours: Integer\n    - labHours: Integer\n    - isMandatory: Boolean\n    + getTotalHours(): Integer\n    + canBeSelfStudy(): Boolean\n    + setMandatory(mandatory: Boolean): void\n}\n\n' \u041e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043c\u0435\u0436\u0434\u0443 \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u044f\u043c\u0438\nFaculty \&quot;1\&quot; *-- \&quot;1..*\&quot; Department : contains &gt;\nDepartment \&quot;1\&quot; *-- \&quot;1..*\&quot; Teacher : employs &gt;\nDepartment \&quot;1\&quot; o-- \&quot;*\&quot; Course : oversees &gt;\nTeacher \&quot;1\&quot; o-- \&quot;*\&quot; Course : conducts &gt;\n\n' \u0414\u0435\u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0446\u0438\u044f \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430 Course\nCourse \&quot;1\&quot; *-- \&quot;1\&quot; AuditoryHours : contains &gt;\nCourse \&quot;1\&quot; *-- \&quot;1\&quot; AssessmentPlan : specifies &gt;\nCourse \&quot;1\&quot; *-- \&quot;1\&quot; CourseSchedule : follows &gt;\nCourse \&quot;1\&quot; *-- \&quot;1..*\&quot; Topic : consists of &gt;\nCourse ..&gt; AcademicLoad : calculates via &gt;\n\n' \u0417\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0439\nTeacher ..&gt; AcademicDegree : uses\nTeacher ..&gt; AcademicTitle : uses\nTeacher ..&gt; Position : uses\nTeacher ..&gt; Gender : uses\nAssessmentPlan ..&gt; ReportingForm : defines\n\nnote right of Faculty\n  &lt;b&gt;\u0411\u0438\u0437\u043d\u0435\u0441-\u043f\u0440\u0430\u0432\u0438\u043b\u043e 1:&lt;/b&gt;\n  calculateTotalTeachers() &lt;= floor(studentCount / 10)\nend note\n\nnote bottom of AssessmentPlan\n  &lt;b&gt;\u0424\u043e\u0440\u043c\u0430 \u043e\u0442\u0447\u0451\u0442\u043d\u043e\u0441\u0442\u0438:&lt;/b&gt;\n  \u0412\u0437\u0430\u0438\u043c\u043e\u0438\u0441\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0438\u0435 \u0444\u043e\u0440\u043c\u044b:\n  \u2022 EXAM: 0.5 * \u0441\u0442\u0443\u0434 + 2 \u0447 \u043f\u0440\u0435\u0434\u044d\u043a\u0437. \u043a\u043e\u043d\u0441.\n  \u2022 PASS_TEST: 0.25 * \u0441\u0442\u0443\u0434\n  \u041a\u0420: 0.15 * \u0441\u0442\u0443\u0434 * controlWorkCount\nend note\n\nnote bottom of AcademicLoad\n  &lt;b&gt;\u0424\u043e\u0440\u043c\u0443\u043b\u0430 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043a\u0443\u0440\u0441\u0430:&lt;/b&gt;\n  TotalHours = ceil(\n    Lec + Prac + Lab\n    + 0.05 * Lec\n    + (isExam ? 2.0 : 0)\n    + (isExam ? 0.5 * students : 0.25 * students)\n    + 0.15 * students * tests\n  )\nend note\n\nnote right of Topic\n  &lt;b&gt;\u0411\u0438\u0437\u043d\u0435\u0441-\u043f\u0440\u0430\u0432\u0438\u043b\u043e 2:&lt;/b&gt;\n  \u0414\u043b\u044f \u0442\u0435\u043c \u043d\u0430 \u0421\u0420\u0421 (isMandatory = false):\n  hoursSelfStudy(k) &lt;= 0.15 * Course.hours(k)\nend note\n\n@enduml\n\n&quot;, &quot;config&quot;: null}" id="puml_root">
