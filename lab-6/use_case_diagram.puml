@startuml
left to right direction
skinparam actorStyle awesome
skinparam roundcorner 10
skinparam usecase {
  BackgroundColor White
  BorderColor #2C3E50
}

actor "Незарегистрированный пользователь" as act_guest
actor "Пользователь" as act_user
actor "Клиент" as act_client
actor "Пользователь организации" as act_staff
actor "Владелец организации" as act_owner
actor "Редактор (п. 3.3.4 ТЗ)" as act_editor
actor "Администратор" as act_admin
actor "Владелец сайта" as act_site
actor "Сервис SMS" as act_sms
actor "Платежная система" as act_pay

rectangle "Информационная система «Project Record (Электронная запись)»" {
  usecase "UC1: Просмотр каталога и расписания (2.3.1.1–3)" as uc1
  usecase "UC2: Поиск и фильтрация услуг и цен (2.3.1.1, 2.3.1.6)" as uc2
  usecase "UC3: Зарегистрироваться как Клиент (п. 3.2.1)" as uc3
  usecase "UC4: Зарегистрироваться как Организация (п. 3.2.2)" as uc4
  usecase "UC5: Войти в Систему (п. 3.2.3)" as uc5
  usecase "UC6: Восстановить пароль (п. 3.2.4.4.2)" as uc6
  usecase "UC7: Изменить личный профиль и телефон (п. 3.2.4)" as uc7
  usecase "UC8: Удалить профиль (п. 3.2.4.4.3)" as uc8
  usecase "UC9: Общаться на форуме и комментировать (3.3.2, 3.3.4)" as uc9
  usecase "UC10: Добавить пожелание по сайту (2.3.3.4, 3.3.3)" as uc10
  usecase "UC11: Записаться на приём / бронь (п. 2.3.1.5, 3.2.16)" as uc11
  usecase "UC12: Избранное, отзывы и оценка likeIt (2.3.1.1–2, 2.3.1.8)" as uc12
  usecase "UC13: Обратная связь и обратный звонок (п. 2.3.1.7)" as uc13
  usecase "UC14: Он-лайн консультация клиента (п. 2.3.1.9)" as uc14
  usecase "UC15: Управлять справочниками (п. 3.2.9)" as uc15
  usecase "UC16: Добавить новость организации (п. 3.2.10)" as uc16
  usecase "UC17: Изменить график работы (п. 3.2.11)" as uc17
  usecase "UC18: Загрузить/выгрузить расписание (п. 3.2.12)" as uc18
  usecase "UC19: Управлять Клиентами: Обычный / VIP (п. 3.2.13)" as uc19
  usecase "UC20: Разрешать конфликты и записи (2.3.2.7, 3.2.16.4.1)" as uc20
  usecase "UC21: Консультировать клиентов и отвечать на отзывы (2.3.2.9)" as uc21
  usecase "UC22: Добавить, изменить и активировать организацию (3.2.7)" as uc22
  usecase "UC23: Дать права на управление организацией (п. 3.2.8)" as uc23
  usecase "UC24: Оплатить за сервис (п. 3.2.14, 2.3.3.2)" as uc24
  usecase "UC25: Получить отчёты по организации (3.2.15, 3.3.9.2)" as uc25
  usecase "UC26: Публиковать/изменять/ удалять новости сайта (п. 3.3.4)" as uc26
  usecase "UC27: Изменить профиль другого пользователя (п. 3.2.5)" as uc27
  usecase "UC28: Заблокировать/разблокировать пользователя (п. 3.2.6)" as uc28
  usecase "UC29: Модерировать услуги и справочники (2.3.2.4, 3.3.5)" as uc29
  usecase "UC30: Управлять структурой форума (п. 3.3.2)" as uc30
  usecase "UC31: Получить отчёты для Владельца сайта (2.3.3.1, 3.3.9.3)" as uc31
  usecase "UC32: Отправить SMS-код / уведомление (3.2.1, 3.2.4, 3.3.1)" as uc32
  usecase "UC33: Обработать платёжную транзакцию (3.2.14, 2.3.3.2)" as uc33
}

act_guest --> uc1
act_guest --> uc2
act_guest --> uc3
act_guest --> uc4
act_guest --> uc5
act_guest --> uc6
act_user --> uc7
act_user --> uc8
act_user --> uc9
act_user --> uc10
act_client --> uc11
act_client --> uc12
act_client --> uc13
act_client --> uc14
act_staff --> uc15
act_staff --> uc16
act_staff --> uc17
act_staff --> uc18
act_staff --> uc19
act_staff --> uc20
act_staff --> uc21
act_owner --> uc22
act_owner --> uc23
act_owner --> uc24
act_owner --> uc25
act_editor --> uc26
act_admin --> uc27
act_admin --> uc28
act_admin --> uc29
act_admin --> uc30
act_site --> uc31
uc32 -- act_sms
uc33 -- act_pay
@enduml
