@startuml
left to right direction
skinparam actorStyle awesome
skinparam roundcorner 10
skinparam usecase {
  BackgroundColor White
  BorderColor #2C3E50
}

actor "Гость" as Guest
actor "Зарегистрированный пользователь" as RegUser
actor "Клиент" as Client
actor "Сотрудник организации" as Staff
actor "Владелец организации" as OrgOwner
actor "Редактор контента" as Editor
actor "Администратор системы" as Admin
actor "Владелец сайта" as SiteOwner

Client --|> RegUser
Staff --|> RegUser
OrgOwner --|> Staff
Editor --|> RegUser
Admin --|> RegUser
SiteOwner --|> RegUser

actor "SMS-шлюз" as SmsGw
actor "Email-сервер" as EmailGw
actor "Платёжная система" as PayGw

rectangle "Информационная система «Project Record»" {
  usecase "UC1: Просмотр каталога и расписания" as UC1
  usecase "UC2: Поиск и фильтрация услуг" as UC2
  usecase "UC3: Регистрация аккаунта" as UC3
  usecase "UC4: Подтверждение Email / SMS-кода" as UC4
  usecase "UC5: Авторизация и сброс пароля" as UC5
  usecase "UC6: Управление профилем и телефоном" as UC6
  usecase "UC7: Форум и комментарии" as UC7
  usecase "UC8: Пожелания по сайту" as UC8
  usecase "UC9: Онлайн-запись / бронирование" as UC9
  usecase "UC10: Отправка SMS/Email уведомлений" as UC10
  usecase "UC11: Отмена или перенос брони" as UC11
  usecase "UC12: Избранное, Like и отзывы" as UC12
  usecase "UC13: Онлайн-консультация и звонок" as UC13
  usecase "UC14: Справочники организации" as UC14
  usecase "UC15: График работы и периодичность" as UC15
  usecase "UC16: Очередь и разрешение конфликтов" as UC16
  usecase "UC17: База клиентов (Обычный/VIP)" as UC17
  usecase "UC18: Импорт/экспорт расписания" as UC18
  usecase "UC19: Новости организации и ответы" as UC19
  usecase "UC20: Создание и статус организации" as UC20
  usecase "UC21: Делегирование прав управления" as UC21
  usecase "UC22: Оплата подписки" as UC22
  usecase "UC23: Отчёты организации (XLS/PDF)" as UC23
  usecase "UC24: Редактирование контента сайта" as UC24
  usecase "UC25: Модерация и блокировка профилей/IP" as UC25
  usecase "UC26: Модерация единого каталога услуг" as UC26
  usecase "UC27: Управление форумом и аудит логов" as UC27
  usecase "UC28: Сводная аналитика владельца сайта" as UC28

  UC3 ..> UC4 : <<include>>
  UC6 ..> UC4 : <<include>>
  UC9 ..> UC10 : <<include>>
}

Guest --> UC1
Guest --> UC2
Guest --> UC3
Guest --> UC5
RegUser --> UC6
RegUser --> UC7
RegUser --> UC8
Client --> UC9
Client --> UC11
Client --> UC12
Client --> UC13
Staff --> UC14
Staff --> UC15
Staff --> UC16
Staff --> UC17
Staff --> UC18
Staff --> UC19
OrgOwner --> UC20
OrgOwner --> UC21
OrgOwner --> UC22
OrgOwner --> UC23
Editor --> UC24
Admin --> UC25
Admin --> UC26
Admin --> UC27
SiteOwner --> UC28

UC4 -- SmsGw
UC4 -- EmailGw
UC5 -- EmailGw
UC10 -- SmsGw
UC10 -- EmailGw
UC22 -- PayGw
@enduml
