@startuml
skinparam classAttributeIconSize 0
skinparam roundcorner 8

class User {
  - id: UUID
  - login: String
  - passwordHash: String
  - firstName: String
  - lastName: String
  - gender: Gender
  - phone: String
  - email: String
  - city: String
  - status: UserStatus
  - isDeleted: Boolean
  + authenticate(pwd: String): Boolean
  + updateProfile(name: String, tel: String): void
  + softDelete(): void
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Gender {
  MALE
  FEMALE
}

enum RoleType {
  CLIENT
  ORG_USER
  ORG_OWNER
  EDITOR
  ADMIN
  SITE_OWNER
}

class OrganizationRoleAssignment {
  - userId: UUID
  - organizationId: UUID
  - role: RoleType
  - grantedAt: DateTime
  + hasPermission(perm: String): Boolean
}

class ClientOrganizationRelation {
  - clientId: UUID
  - organizationId: UUID
  - tier: ClientTier
  - isFavorite: Boolean
  + setTier(tier: ClientTier): void
}

enum ClientTier {
  REGULAR
  VIP
}

class AuditLogEntry {
  - id: UUID
  - entityName: String
  - entityId: UUID
  - oldValuesJson: String
  - newValuesJson: String
  - changedByUserId: UUID
  - ipAddress: String
  - sessionId: String
  - timestamp: DateTime
  + getDiffSummary(): String
}

class AuditRepository {
  - storageEngine: String
  + recordChange(e: AuditLogEntry): void
  + findByEntity(id: UUID): List<AuditLogEntry>
}

class Organization {
  - id: UUID
  - name: String
  - description: String
  - address: String
  - phone: String
  - email: String
  - mapCoordinates: String
  - isActive: Boolean
  - paymentStatus: PaymentStatus
  + activate(): void
  + deactivate(): void
  + addService(s: Service): void
}

class ServiceCategory {
  - id: UUID
  - name: String
  - isApprovedByAdmin: Boolean
  + approve(): void
}

class Service {
  - id: UUID
  - name: String
  - description: String
  - price: Decimal
  - durationMin: Integer
  - bufferMin: Integer
  - isDeleted: Boolean
  + calculateEndTime(st: DateTime): DateTime
}

interface IBookableResource {
  + getId(): UUID
  + getName(): String
  + getWorkSchedules(): List<WorkSchedule>
  + isAvailable(s: DateTime, e: DateTime): Boolean
}

class Employee {
  - id: UUID
  - fullName: String
  - bio: String
  - photoUrl: String
  - likesCount: Integer
  + isAvailable(s: DateTime, e: DateTime): Boolean
}

class Room {
  - id: UUID
  - name: String
  - capacity: Integer
  - floor: String
  + isAvailable(s: DateTime, e: DateTime): Boolean
}

class WorkSchedule {
  - id: UUID
  - date: Date
  - startTime: Time
  - endTime: Time
  - isFloating: Boolean
  - minGapMinutes: Integer
  - isPublished: Boolean
  + hasOverlap(other: WorkSchedule): Boolean
}

class RecurrenceRule {
  - id: UUID
  - frequency: FrequencyType
  - intervalCount: Integer
  - daysOfWeek: List<Integer>
  - endDate: Date
  + generateOccurrences(): List<WorkSchedule>
}

enum FrequencyType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

class Booking {
  - id: UUID
  - clientId: UUID
  - resourceId: UUID
  - serviceId: UUID
  - startTime: DateTime
  - endTime: DateTime
  - status: BookingStatus
  - remindBeforeMin: Integer
  + confirm(): void
  + cancel(): void
  + reschedule(st: DateTime): void
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CONFLICT
  CANCELLED
  COMPLETED
}

class BookingController {
  - notifService: NotificationService
  - auditRepo: AuditRepository
  + createBooking(cliId: UUID, resId: UUID, st: DateTime): Booking
  + resolveConflict(id: UUID): void
  + exportSchedule(fmt: String): ByteArray
}

class NotificationService {
  - senders: Map<NotificationChannel, INotificationSender>
  + addSender(ch: NotificationChannel, s: INotificationSender): void
  + notifyUser(u: User, msg: String): void
}

enum NotificationChannel {
  SMS
  EMAIL
}

interface INotificationSender {
  + send(recipient: String, text: String): Boolean
}

class SmsNotificationSender {
  - apiKey: String
  + send(to: String, txt: String): Boolean
}

class EmailNotificationSender {
  - smtpHost: String
  + send(to: String, txt: String): Boolean
}

class PaymentTransaction {
  - id: UUID
  - organizationId: UUID
  - amount: Decimal
  - status: PaymentStatus
  - createdAt: DateTime
  + processPayment(): Boolean
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

class Review {
  - id: UUID
  - authorId: UUID
  - organizationId: UUID
  - employeeId: UUID
  - rating: Integer
  - commentText: String
  + publish(): void
}

class NewsItem {
  - id: UUID
  - organizationId: UUID
  - title: String
  - content: String
  - publishedAt: DateTime
  + addComment(u: User, text: String): void
}

User ..> UserStatus
User ..> Gender
User --> OrganizationRoleAssignment : назначается
OrganizationRoleAssignment --> Organization : к организации
OrganizationRoleAssignment ..> RoleType
User --> ClientOrganizationRelation
ClientOrganizationRelation --> Organization
ClientOrganizationRelation ..> ClientTier
User --> Booking : оформляет
AuditRepository --> AuditLogEntry : хранит
Organization --> ServiceCategory : использует
ServiceCategory o-- Service
Organization *-- Service
Organization o-- IBookableResource
Employee ..|> IBookableResource
Room ..|> IBookableResource
IBookableResource *-- WorkSchedule
WorkSchedule --> RecurrenceRule : повторяется
RecurrenceRule ..> FrequencyType
IBookableResource --> Booking : бронируется
Service --> Booking : в брони
Booking ..> BookingStatus
BookingController ..> NotificationService : delegates
BookingController ..> AuditRepository : audit
NotificationService ..> NotificationChannel
NotificationService o-- INotificationSender
SmsNotificationSender ..|> INotificationSender
EmailNotificationSender ..|> INotificationSender
Organization --> PaymentTransaction
PaymentTransaction ..> PaymentStatus
Organization *-- NewsItem
User --> Review : автор
Organization --> Review
Employee --> Review
@enduml
