@startuml
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam actorStyle awesome
skinparam monochrome false
skinparam handwritten false

skinparam usecase {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor #2980B9
}

skinparam actor {
    BackgroundColor White
    BorderColor #2C3E50
}

actor "Иванушка\n(Человек)" as Ivanushka
actor "Козлёночек\n(Околдованный)" as Goat
actor "Алёнушка" as Alenushka
actor "Купец" as Merchant
actor "Ведьма" as Witch
actor "Слуга" as Servant
actor "Народ" as People

Ivanushka -- Goat : перевоплощение

rectangle "Сказка: Сестрица Алёнушка и братец Иванушка" {

    rectangle "Дорога и превращение" {
        usecase "UC1: Испытывать жажду" as UC1
        usecase "UC2: Просить разрешения напиться" as UC2
        usecase "UC3: Запретить пить из копытца" as UC3
        usecase "UC4: Напиться из козьего копытца" as UC4
        usecase "UC5: Превратиться в козлёночка" as UC5

        UC4 .> UC5 : <<include>>
        UC2 ..> UC3 : <<communicates>>
    }

    rectangle "Спасение от сиротства и брак" {
        usecase "UC6: Оплакивать беду" as UC6
        usecase "UC7: Предложить замужество и кров" as UC7
        usecase "UC8: Вступить в брак" as UC8
        usecase "UC9: Приютить козлёночка" as UC9

        UC8 .> UC9 : <<include>>
    }

    rectangle "Злодеяние ведьмы и подмена" {
        usecase "UC10: Заманить на реку" as UC10
        usecase "UC11: Утопить с камнем на шее" as UC11
        usecase "UC12: Принять облик Алёнушки" as UC12
        usecase "UC13: Обмануть купца" as UC13
        usecase "UC14: Уговорить зарезать козлёнка" as UC14
        usecase "UC15: Приказать точить ножи и греть котлы" as UC15

        UC10 .> UC11 : <<include>>
        UC12 .> UC13 : <<include>>
    }

    rectangle "Тайна у реки и разоблачение" {
        usecase "UC16: Отпроситься на речку" as UC16
        usecase "UC17: Звать сестрицу на берегу" as UC17
        usecase "UC18: Отвечать братцу со дна реки" as UC18
        usecase "UC19: Искать козлёнка" as UC19
        usecase "UC20: Подслушать диалог у реки" as UC20
        usecase "UC21: Донести правду купцу" as UC21

        UC20 .> UC17 : <<extend>>
        UC17 ..> UC18 : <<interacts>>
    }

    rectangle "Спасение, расколдовывание и возмездие" {
        usecase "UC22: Собрать народ на спасение" as UC22
        usecase "UC23: Вытащить Алёнушку шёлковыми сетями" as UC23
        usecase "UC24: Снять камень и оживить ключевой водой" as UC24
        usecase "UC25: Кувыркнуться и расколдоваться" as UC25
        usecase "UC26: Привязать ведьму к коню и пустить в поле" as UC26

        UC23 .> UC24 : <<include>>
        UC25 .> UC24 : <<extend>>
    }
}

' Связи акторов с прецедентами
Ivanushka --> UC1
Ivanushka --> UC2
Alenushka --> UC3
Ivanushka --> UC4

Alenushka --> UC6
Merchant --> UC7
Alenushka --> UC8
Merchant --> UC8
Goat --> UC9

Witch --> UC10
Alenushka --> UC10
Witch --> UC11
Witch --> UC12
Witch --> UC14
Merchant --> UC14
Witch --> UC15

Goat --> UC16
Merchant --> UC16
Goat --> UC17
Alenushka --> UC18
Servant --> UC19
Witch --> UC19
Servant --> UC20
Servant --> UC21
Merchant --> UC21

Merchant --> UC22
People --> UC22
People --> UC23
People --> UC24
Goat --> UC25
People --> UC26

@enduml
