        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam roundcorner 10\nskinparam packageStyle rectangle\n\nskinparam class {\n    BackgroundColor White\n    BorderColor #2C3E50\n    ArrowColor #2980B9\n}\n\n\&quot; ==========================================\n\&quot; 1. Базовые абстракции пространства и вещей\n\&quot; ==========================================\nabstract class Место {\n    - название: String\n}\n\nclass ДорогаВПоле extends Место\nclass ХоромыКупца extends Место\nclass БерегРеки extends Место\n\nabstract class ИсточникВоды extends Место {\n    - полноВодицы: Boolean\n    + испить()\n}\n\nclass Копытце extends ИсточникВоды {\n    - видСледа: String\n    - эффектПревращения: String\n    + оказатьМагическийЭффект(персонаж: Персонаж)\n}\n\nclass Колодец extends ИсточникВоды {\n    - расстояние: String\n}\n\nclass Река extends ИсточникВоды {\n    - шёлковаТрава: Boolean\n    - жёлтыПески: Boolean\n}\n\nclass ВодаКлючевая extends ИсточникВоды {\n    - живительнаяСила: Boolean\n    + оживить(персонаж: Персонаж)\n}\n\nabstract class Вещь {\n    - название: String\n    - вес: Double\n}\n\nclass Камень extends Вещь\nclass СетиШёлковые extends Вещь {\n    - материал: String = &quot;шёлк&quot;\n}\nclass Одежда extends Вещь {\n    - тип: String\n}\n\n\&quot; ==========================================\n\&quot; 2. Базовые абстракции персонажей и речи\n\&quot; ==========================================\ninterface Говорящий {\n    + сказать(кому: Персонаж, текст: String)\n    + попросить(уКого: Персонаж, просьба: String): Boolean\n}\n\nabstract class Персонаж {\n    - имя: String\n    - живой: Boolean\n    - текущееМесто: Место\n    + переместиться(куда: Место)\n}\n\nabstract class Человек extends Персонаж implements Говорящий {\n    - пол: String\n    + сказать(кому: Персонаж, текст: String)\n    + попросить(уКого: Персонаж, просьба: String): Boolean\n    + приказать(кому: Персонаж, приказ: String)\n    + надеть(вещь: Вещь)\n    + снять(вещь: Вещь, сКого: Персонаж)\n    + прикрепить(вещь: Вещь, кКому: Персонаж)\n}\n\nabstract class Животное extends Персонаж {\n    - порода: String\n    + издатьЗвук()\n}\n\nclass Конь extends Животное {\n    + скакать(куда: Место)\n}\n\n\&quot; ==========================================\n\&quot; 3. Конкретные персонажи\n\&quot; ==========================================\nclass Алёнушка extends Человек {\n    - замужем: Boolean\n    + выйтиЗамуж(купец: Купец)\n    + ответить(кому: Персонаж, текст: String)\n    + ожить()\n}\n\nclass Иванушка extends Человек {\n    - испытываетЖажду: Boolean\n    + испить(источник: ИсточникВоды)\n    + превратиться(облик: String)\n}\n\nclass Козлёночек extends Животное implements Говорящий {\n    - цветШерсти: String = &quot;белый&quot;\n    + сказать(кому: Персонаж, текст: String)\n    + попросить(уКого: Персонаж, просьба: String): Boolean\n    + кувыркнуться(): Boolean\n    + расколдоваться(): Иванушка\n}\n\nclass Купец extends Человек {\n    - вОтъезде: Boolean\n    + предложитьБрак(девица: Алёнушка)\n    + приютить(кого: Персонаж)\n    + отпустить(кого: Персонаж)\n    + созвать(народ: Народ)\n}\n\nclass Ведьма extends Человек {\n    - текущийОблик: String\n    + заманить(кого: Персонаж, куда: Место)\n    + принятьОблик(человек: Человек)\n    + погрузить(кого: Персонаж, куда: ИсточникВоды)\n}\n\nclass Слуга extends Человек {\n    + искать(кого: Персонаж, где: Место): Персонаж\n    + подслушать(источник: Персонаж): String\n}\n\nclass Народ extends Персонаж {\n    - численность: Integer\n    + созваться()\n    + применить(вещь: Вещь, цель: Место)\n    + извлечь(кого: Персонаж, откуда: Место)\n    + отпустить(кого: Персонаж)\n}\n\n\&quot; ==========================================\n\&quot; 4. Связи, ассоциации и зависимости\n\&quot; ==========================================\nАлёнушка &quot;1&quot; -- &quot;1&quot; Иванушка : кровное родство\nКупец &quot;1&quot; -- &quot;0..1&quot; Алёнушка : супруги\nКупец &quot;1&quot; o-- &quot;*&quot; Слуга : нанимает\nКупец &quot;1&quot; --&gt; &quot;1&quot; Козлёночек : приютил в доме\n\nКозлёночек &quot;1&quot; o--&gt; &quot;1&quot; Иванушка : воплощает личность\n\nАлёнушка &quot;1&quot; o-- &quot;0..1&quot; Камень : скована на дне\n\nПерсонаж &quot;*&quot; --&gt; &quot;1&quot; Место : находится в\n\nВедьма &quot;1&quot; ..&gt; &quot;1&quot; Алёнушка : имитирует и вредит\nСлуга &quot;1&quot; ..&gt; &quot;1&quot; Купец : доносит весть\nСлуга &quot;1&quot; ..&gt; &quot;1&quot; Козлёночек : выслеживает у реки\nКозлёночек &quot;1&quot; ..&gt; &quot;1&quot; Река : взывает к сестре\nИванушка &quot;1&quot; ..&gt; &quot;1&quot; Копытце : пьет воду из\n\nНарод &quot;*&quot; ..&gt; &quot;1&quot; Алёнушка : спасает из реки\nНарод &quot;*&quot; ..&gt; &quot;1&quot; Ведьма : наказывает\n\n@enduml\n&quot;, &quot;config&quot;: None}" id="puml_root">
