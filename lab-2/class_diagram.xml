        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam roundcorner 10\nskinparam packageStyle rectangle\n\nskinparam class {\n    BackgroundColor White\n    BorderColor #2C3E50\n    ArrowColor #2980B9\n}\n\nenum ТипЖивотного {\n    КОРОВА\n    ЛОШАДЬ\n    КОЗА\n}\n\nenum СостояниеАлёнушки {\n    ДЕВИЦА\n    СУПРУГА\n    УТОПЛЕННИЦА\n    ОЖИВШАЯ\n}\n\ninterface Персонаж {\n    - имя: String\n    - жив: Boolean\n    + переместиться(локация: String)\n    + сказать(фраза: String)\n}\n\ninterface ВолшебноеСущество {\n    + трансформироваться(новыйОблик: String)\n}\n\nabstract class Человек implements Персонаж {\n    - имя: String\n    - жив: Boolean\n    - пол: String\n    + одеть(одежда: String)\n    + переместиться(локация: String)\n    + сказать(фраза: String)\n}\n\nclass Алёнушка extends Человек {\n    - состояние: СостояниеАлёнушки\n    - замужем: Boolean\n    + предостеречьБратца(копытце: Копытце)\n    + оплакиватьБеду()\n    + выйтиЗамуж(купец: Купец)\n    + доверитьсяВедьме(ведьма: Ведьма)\n    + ответитьСоДна(братец: Козлёночек): String\n    + ожить(вода: ВодаКлючевая)\n}\n\nclass Иванушка extends Человек {\n    - испытываетЖажду: Boolean\n    + попроситьНапиться(копытце: Копытце)\n    + напиться(копытце: Копытце)\n    + превратитьсяВКозлёнка(): Козлёночек\n}\n\nclass Козлёночек extends Иванушка implements ВолшебноеСущество {\n    - цветШерсти: String\n    - сохраняетЧеловеческийРазум: Boolean\n    - знаетОЗлодеянии: Boolean\n    - подУгрозойЗаклания: Boolean\n    + бежатьЗаСестрой()\n    + тосковать()\n    + отказатьсяОтПищи()\n    + отпроситьсяНаРеку(купец: Купец): Boolean\n    + зватьСестрицу(река: Река)\n    + кувыркнутьсяТрижды()\n    + расколдоваться(): Иванушка\n}\n\nclass Купец extends Человек {\n    - вОтъезде: Boolean\n    + предложитьЗамужество(девица: Алёнушка)\n    + приютитьКозлёнка(козлёночек: Козлёночек)\n    + согласитьсяНаЗаклание()\n    + отпуститьКозлёнка(козлёночек: Козлёночек)\n    + выслушатьДоклад(слуга: Слуга)\n    + собратьНарод()\n    + спастиСупругу()\n    + наказатьВедьму(ведьма: Ведьма)\n}\n\nclass Ведьма extends Человек implements ВолшебноеСущество {\n    - текущийОблик: String\n    - разоблачена: Boolean\n    + выследитьОтсутствие(купец: Купец)\n    + заманитьНаРеку(жертва: Алёнушка)\n    + утопитьСКамнем(жертва: Алёнушка, камень: Камень, река: Река)\n    + принятьОблик(человек: Алёнушка)\n    + упрашиватьМужа(купец: Купец)\n    + приказатьСлугамТочитьНожи()\n    + послатьНаПоиски(слуга: Слуга)\n}\n\nclass Слуга extends Человек {\n    + выполнятьПоручение(ведьма: Ведьма)\n    + искатьКозлёнка(река: Река)\n    + подслушатьДиалог(): String\n    + доложитьКупцу(купец: Купец, весть: String)\n}\n\nclass Народ {\n    - численность: Integer\n    + закинутьСети(река: Река, сети: СетиШёлковые)\n    + вытащитьНаБерег(жертва: Алёнушка)\n    + снятьКамень(жертва: Алёнушка)\n    + окунутьВКлючевуюВоду(жертва: Алёнушка)\n    + привязатьККоню(ведьма: Ведьма, конь: Конь)\n    + отправитьВПоле(конь: Конь)\n}\n\nabstract class ИсточникВоды {\n    - локация: String\n    - полноВодицы: Boolean\n    + испить()\n}\n\nclass Копытце extends ИсточникВоды {\n    - животное: ТипЖивотного\n    - эффектПревращения: ТипЖивотного\n    + оказатьМагическийЭффект(персонаж: Иванушка)\n}\n\nclass Колодец extends ИсточникВоды {\n    - расстояние: String\n}\n\nclass Река extends ИсточникВоды {\n    - шёлковаТрава: Boolean\n    - жёлтыПески: Boolean\n}\n\nclass Камень {\n    - тяжесть: Double\n    - привязанКШее: Boolean\n}\n\nclass СетиШёлковые {\n    - материал: String\n    + закинуть()\n    + извлечь()\n}\n\nclass ВодаКлючевая {\n    - живительнаяСила: Boolean\n    + оживить(персонаж: Алёнушка)\n}\n\nclass Конь {\n    - привязанаВедьма: Boolean\n    + скакатьВЧистоеПоле()\n}\n\n\&quot; Отношения и ассоциации\nАлёнушка &quot;1&quot; -- &quot;1&quot; Иванушка : родство (сестра и брат)\nКупец &quot;1&quot; -- &quot;0..1&quot; Алёнушка : супруги\nКупец &quot;1&quot; o-- &quot;*&quot; Слуга : хозяин и слуги\nКупец &quot;1&quot; --&gt; &quot;1&quot; Козлёночек : приютил в доме\n\nВедьма &quot;1&quot; ..&gt; &quot;1&quot; Алёнушка : топит и принимает облик\nВедьма &quot;1&quot; ..&gt; &quot;1&quot; Козлёночек : добивается заклания\nВедьма &quot;1&quot; ..&gt; &quot;*&quot; Слуга : посылает на поиски\n\nСлуга &quot;1&quot; ..&gt; &quot;1&quot; Купец : доносит правду\nСлуга &quot;1&quot; ..&gt; &quot;1&quot; Козлёночек : выслеживает у реки\n\nКозлёночек &quot;1&quot; ..&gt; &quot;1&quot; Река : ходит и зовет сестрицу\nАлёнушка &quot;1&quot; o-- &quot;0..1&quot; Камень : скована на дне\n\nИванушка &quot;1&quot; ..&gt; &quot;1&quot; Копытце : пьет воду из\n\nНарод &quot;*&quot; ..&gt; &quot;1&quot; Алёнушка : спасает сетями\nНарод &quot;*&quot; ..&gt; &quot;1&quot; СетиШёлковые : использует\nНарод &quot;*&quot; ..&gt; &quot;1&quot; ВодаКлючевая : использует\nНарод &quot;*&quot; ..&gt; &quot;1&quot; Ведьма : связывает\nНарод &quot;*&quot; ..&gt; &quot;1&quot; Конь : пускает в поле\n\n@enduml\n&quot;, &quot;config&quot;: None}" id="puml_root">
