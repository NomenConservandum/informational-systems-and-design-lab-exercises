@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 10
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor #2980B9
}

enum ТипЖивотного {
    КОРОВА
    ЛОШАДЬ
    КОЗА
}

enum СостояниеАлёнушки {
    ДЕВИЦА
    СУПРУГА
    УТОПЛЕННИЦА
    ОЖИВШАЯ
}

interface Персонаж {
    - имя: String
    - жив: Boolean
    + переместиться(локация: String)
    + сказать(фраза: String)
}

interface ВолшебноеСущество {
    + трансформироваться(новыйОблик: String)
}

abstract class Человек implements Персонаж {
    - имя: String
    - жив: Boolean
    - пол: String
    + одеть(одежда: String)
    + переместиться(локация: String)
    + сказать(фраза: String)
}

class Алёнушка extends Человек {
    - состояние: СостояниеАлёнушки
    - замужем: Boolean
    + предостеречьБратца(копытце: Копытце)
    + оплакиватьБеду()
    + выйтиЗамуж(купец: Купец)
    + доверитьсяВедьме(ведьма: Ведьма)
    + ответитьСоДна(братец: Козлёночек): String
    + ожить(вода: ВодаКлючевая)
}

class Иванушка extends Человек {
    - испытываетЖажду: Boolean
    + попроситьНапиться(копытце: Копытце)
    + напиться(копытце: Копытце)
    + превратитьсяВКозлёнка(): Козлёночек
}

class Козлёночек extends Иванушка implements ВолшебноеСущество {
    - цветШерсти: String
    - сохраняетЧеловеческийРазум: Boolean
    - знаетОЗлодеянии: Boolean
    - подУгрозойЗаклания: Boolean
    + бежатьЗаСестрой()
    + тосковать()
    + отказатьсяОтПищи()
    + отпроситьсяНаРеку(купец: Купец): Boolean
    + зватьСестрицу(река: Река)
    + кувыркнутьсяТрижды()
    + расколдоваться(): Иванушка
}

class Купец extends Человек {
    - вОтъезде: Boolean
    + предложитьЗамужество(девица: Алёнушка)
    + приютитьКозлёнка(козлёночек: Козлёночек)
    + согласитьсяНаЗаклание()
    + отпуститьКозлёнка(козлёночек: Козлёночек)
    + выслушатьДоклад(слуга: Слуга)
    + собратьНарод()
    + спастиСупругу()
    + наказатьВедьму(ведьма: Ведьма)
}

class Ведьма extends Человек implements ВолшебноеСущество {
    - текущийОблик: String
    - разоблачена: Boolean
    + выследитьОтсутствие(купец: Купец)
    + заманитьНаРеку(жертва: Алёнушка)
    + утопитьСКамнем(жертва: Алёнушка, камень: Камень, река: Река)
    + принятьОблик(человек: Алёнушка)
    + упрашиватьМужа(купец: Купец)
    + приказатьСлугамТочитьНожи()
    + послатьНаПоиски(слуга: Слуга)
}

class Слуга extends Человек {
    + выполнятьПоручение(ведьма: Ведьма)
    + искатьКозлёнка(река: Река)
    + подслушатьДиалог(): String
    + доложитьКупцу(купец: Купец, весть: String)
}

class Народ {
    - численность: Integer
    + закинутьСети(река: Река, сети: СетиШёлковые)
    + вытащитьНаБерег(жертва: Алёнушка)
    + снятьКамень(жертва: Алёнушка)
    + окунутьВКлючевуюВоду(жертва: Алёнушка)
    + привязатьККоню(ведьма: Ведьма, конь: Конь)
    + отправитьВПоле(конь: Конь)
}

abstract class ИсточникВоды {
    - локация: String
    - полноВодицы: Boolean
    + испить()
}

class Копытце extends ИсточникВоды {
    - животное: ТипЖивотного
    - эффектПревращения: ТипЖивотного
    + оказатьМагическийЭффект(персонаж: Иванушка)
}

class Колодец extends ИсточникВоды {
    - расстояние: String
}

class Река extends ИсточникВоды {
    - шёлковаТрава: Boolean
    - жёлтыПески: Boolean
}

class Камень {
    - тяжесть: Double
    - привязанКШее: Boolean
}

class СетиШёлковые {
    - материал: String
    + закинуть()
    + извлечь()
}

class ВодаКлючевая {
    - живительнаяСила: Boolean
    + оживить(персонаж: Алёнушка)
}

class Конь {
    - привязанаВедьма: Boolean
    + скакатьВЧистоеПоле()
}

' Отношения и ассоциации
Алёнушка "1" -- "1" Иванушка : родство (сестра и брат)
Купец "1" -- "0..1" Алёнушка : супруги
Купец "1" o-- "*" Слуга : хозяин и слуги
Купец "1" --> "1" Козлёночек : приютил в доме

Ведьма "1" ..> "1" Алёнушка : топит и принимает облик
Ведьма "1" ..> "1" Козлёночек : добивается заклания
Ведьма "1" ..> "*" Слуга : посылает на поиски

Слуга "1" ..> "1" Купец : доносит правду
Слуга "1" ..> "1" Козлёночек : выслеживает у реки

Козлёночек "1" ..> "1" Река : ходит и зовет сестрицу
Алёнушка "1" o-- "0..1" Камень : скована на дне

Иванушка "1" ..> "1" Копытце : пьет воду из

Народ "*" ..> "1" Алёнушка : спасает сетями
Народ "*" ..> "1" СетиШёлковые : использует
Народ "*" ..> "1" ВодаКлючевая : использует
Народ "*" ..> "1" Ведьма : связывает
Народ "*" ..> "1" Конь : пускает в поле

@enduml
