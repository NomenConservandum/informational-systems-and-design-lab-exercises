@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 10
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor #2980B9
}

' ==========================================
' 1. Базовые абстракции пространства и вещей
' ==========================================
abstract class Место {
    - название: String
}

class ДорогаВПоле extends Место
class ХоромыКупца extends Место
class БерегРеки extends Место

abstract class ИсточникВоды extends Место {
    - полноВодицы: Boolean
    + испить()
}

class Копытце extends ИсточникВоды {
    - видСледа: String
    - эффектПревращения: String
    + оказатьМагическийЭффект(персонаж: Персонаж)
}

class Колодец extends ИсточникВоды {
    - расстояние: String
}

class Река extends ИсточникВоды {
    - шёлковаТрава: Boolean
    - жёлтыПески: Boolean
}

class ВодаКлючевая extends ИсточникВоды {
    - живительнаяСила: Boolean
    + оживить(персонаж: Персонаж)
}

abstract class Вещь {
    - название: String
    - вес: Double
}

class Камень extends Вещь
class СетиШёлковые extends Вещь {
    - материал: String = "шёлк"
}
class Одежда extends Вещь {
    - тип: String
}

' ==========================================
' 2. Базовые абстракции персонажей и речи
' ==========================================
interface Говорящий {
    + сказать(кому: Персонаж, текст: String)
    + попросить(уКого: Персонаж, просьба: String): Boolean
}

abstract class Персонаж {
    - имя: String
    - живой: Boolean
    - текущееМесто: Место
    + переместиться(куда: Место)
}

abstract class Человек extends Персонаж implements Говорящий {
    - пол: String
    + сказать(кому: Персонаж, текст: String)
    + попросить(уКого: Персонаж, просьба: String): Boolean
    + приказать(кому: Персонаж, приказ: String)
    + надеть(вещь: Вещь)
    + снять(вещь: Вещь, сКого: Персонаж)
    + прикрепить(вещь: Вещь, кКому: Персонаж)
}

abstract class Животное extends Персонаж {
    - порода: String
    + издатьЗвук()
}

class Конь extends Животное {
    + скакать(куда: Место)
}

' ==========================================
' 3. Конкретные персонажи
' ==========================================
class Алёнушка extends Человек {
    - замужем: Boolean
    + выйтиЗамуж(купец: Купец)
    + ответить(кому: Персонаж, текст: String)
    + ожить()
}

class Иванушка extends Человек {
    - испытываетЖажду: Boolean
    + испить(источник: ИсточникВоды)
    + превратиться(облик: String)
}

class Козлёночек extends Животное implements Говорящий {
    - цветШерсти: String = "белый"
    + сказать(кому: Персонаж, текст: String)
    + попросить(уКого: Персонаж, просьба: String): Boolean
    + кувыркнуться(): Boolean
    + расколдоваться(): Иванушка
}

class Купец extends Человек {
    - вОтъезде: Boolean
    + предложитьБрак(девица: Алёнушка)
    + приютить(кого: Персонаж)
    + отпустить(кого: Персонаж)
    + созвать(народ: Народ)
}

class Ведьма extends Человек {
    - текущийОблик: String
    + заманить(кого: Персонаж, куда: Место)
    + принятьОблик(человек: Человек)
    + погрузить(кого: Персонаж, куда: ИсточникВоды)
}

class Слуга extends Человек {
    + искать(кого: Персонаж, где: Место): Персонаж
    + подслушать(источник: Персонаж): String
}

class Народ extends Персонаж {
    - численность: Integer
    + созваться()
    + применить(вещь: Вещь, цель: Место)
    + извлечь(кого: Персонаж, откуда: Место)
    + отпустить(кого: Персонаж)
}

' ==========================================
' 4. Связи, ассоциации и зависимости
' ==========================================
Алёнушка "1" -- "1" Иванушка : кровное родство
Купец "1" -- "0..1" Алёнушка : супруги
Купец "1" o-- "*" Слуга : нанимает
Купец "1" --> "1" Козлёночек : приютил в доме

Козлёночек "1" o--> "1" Иванушка : воплощает личность

Алёнушка "1" o-- "0..1" Камень : скована на дне

Персонаж "*" --> "1" Место : находится в

Ведьма "1" ..> "1" Алёнушка : имитирует и вредит
Слуга "1" ..> "1" Купец : доносит весть
Слуга "1" ..> "1" Козлёночек : выслеживает у реки
Козлёночек "1" ..> "1" Река : взывает к сестре
Иванушка "1" ..> "1" Копытце : пьет воду из

Народ "*" ..> "1" Алёнушка : спасает из реки
Народ "*" ..> "1" Ведьма : наказывает

@enduml
